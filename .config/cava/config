[general]
framerate = 60
autosens = 1
bars = 12
lower_cutoff_freq = 50
higher_cutoff_freq = 10000
sleep_timer = 0

[input]
method = pipewire
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
bar_delimiter = 0

[color]
background = default
foreground = default

[smoothing]
monstercat = 0
waves = 0
noise_reduction = 77
